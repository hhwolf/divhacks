# ---- Adaptive Room Planner API ----
# These eight keys are the only secrets. Non-secret config (CORS origin, Gemini model, Mongo db name, grid size) lives in
# apps/api/app/config.py and apps/api/rules.json. Keep comments on their own lines: `docker run --env-file` does not strip them.

# true (default): fully offline, deterministic fixtures, no keys needed. false: the four keys below are required at startup.
# The Docker image sets MOCK_MODE=false.
MOCK_MODE=true

# Required when MOCK_MODE=false
GEMINI_API_KEY=
# Degrades gracefully at runtime (no memory) if Backboard is down
BACKBOARD_API_KEY=
# MongoDB Atlas. Also usable in mock mode; unset -> JSON file store at .data/
MONGODB_URI=
# Vercel Blob: raw USDZ scans, furniture photos, preset GLBs, thumbnails. Unset -> files under .data/blob served at /blob/
BLOB_READ_WRITE_TOKEN=

# Loaded, never called by this service (payments are a non-goal; iMessage runs elsewhere)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# ---- Web app (Vite) — prefixed so they reach the browser ----
VITE_API_URL=http://localhost:8000

# ---- Expo — LAN IP of this Mac for the dev server URLs ----
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173
