# ---- FitCheck: all env vars. Everything runs in mock mode with none of these set. ----
MOCK_MODE=true                 # set false to enable real integrations for services whose keys are present
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173     # used in Photon replies / deep links (prod: https://adaptive-room-planner.vercel.app)
PUBLIC_API_URL=http://localhost:8000     # prod: https://adaptive-room-planner-api.vercel.app
DEMO_PHONE=+15555550100        # shared demo user identity

# Supabase shared storage (leave unset -> Vercel Blob if configured, else JSON file at .data/)
SUPABASE_URL=                  # project URL or copied Data API URL ending in /rest/v1 both work
SUPABASE_SECRET_KEY=           # server-only secret key; legacy SUPABASE_SERVICE_ROLE_KEY also works
SUPABASE_TABLE=arp_documents
SUPABASE_FURNITURE_BUCKET=furniture-assets
SUPABASE_FURNITURE_ASSETS_TABLE=arp_furniture_assets

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backboard memory
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Photon iMessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=       # server-only Spectrum project secret; alias for PHOTON_API_KEY
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
PHOTON_RELAY_SECRET=           # shared HMAC secret between apps/photon-relay and FastAPI /webhooks/photon/normalized
PHOTON_BASE_URL=https://spectrum.photon.codes
PHOTON_FROM=                   # our iMessage line id/handle

# Guarded test checkout configuration is below; no live payments or escrow.

# Web app (Vite) — prefixed so they reach the browser
VITE_API_URL=http://localhost:8000

# Expo — LAN IP of this Mac for the dev server URLs
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173

# Housing comparisons (sample rooms explicitly select demo; real mode never falls back)
HOUSING_DATA_MODE=demo
RENTCAST_API_KEY=              # server-only; whole-apartment listing candidates
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth: public project key only in Vite/Expo. Never copy a secret/service key here.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EVIDENCE_BUCKET=housing-evidence  # private bucket, migration 002

# TEST ONLY. Apply migrations/001_payment_ledger.sql before enabling stripe_test.
PAYMENTS_MODE=demo              # demo | stripe_test; live is rejected
PAYMENTS_DATABASE_URL=         # server-only PostgreSQL DSN; use SSL for hosted DBs
STRIPE_SECRET_KEY=             # sk_test_ only
STRIPE_CONNECTED_ACCOUNT=      # connected acct_ test landlord; scripts/seed_stripe_test.py
STRIPE_WEBHOOK_SECRET=         # whsec_ for CONNECT account events (not just platform events)
# Optional, disposable database for integration tests; never use a production database:
ARP_TEST_DATABASE_URL=
