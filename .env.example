# ---- Adaptive Room Planner: all env vars. Everything runs in mock mode with none of these set. ----
MOCK_MODE=true                 # set false to enable real integrations for services whose keys are present
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173     # used in Photon replies / deep links (prod: https://adaptive-room-planner.vercel.app)
PUBLIC_API_URL=http://localhost:8000     # prod: https://adaptive-room-planner-api.vercel.app
DEMO_PHONE=+15555550100        # shared demo user identity

# Supabase shared storage (leave unset -> Vercel Blob if configured, else JSON file at .data/)
SUPABASE_URL=                  # project URL or copied Data API URL ending in /rest/v1 both work
SUPABASE_SECRET_KEY=           # server-only secret key; legacy SUPABASE_SERVICE_ROLE_KEY also works
SUPABASE_TABLE=arp_documents

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backboard memory
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Photon iMessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=       # server-only Spectrum project secret; alias for PHOTON_API_KEY
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
PHOTON_BASE_URL=https://spectrum.photon.codes
PHOTON_FROM=                   # our iMessage line id/handle

# Guarded payment prototype: record-only. Supabase stores quotes; no card processing/escrow provider is connected.

# Web app (Vite) — prefixed so they reach the browser
VITE_API_URL=http://localhost:8000

# Expo — LAN IP of this Mac for the dev server URLs
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173
