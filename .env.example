# ---- Adaptive Room Planner: all env vars. Everything runs in mock mode with none of these set. ----
# set false to enable real integrations for services whose keys are present
MOCK_MODE=true
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
# used in Photon replies / deep links (prod: https://adaptive-room-planner.vercel.app)
PUBLIC_WEB_URL=http://localhost:5173
# prod: https://adaptive-room-planner-api.vercel.app
PUBLIC_API_URL=http://localhost:8000
# shared demo user identity
DEMO_PHONE=+15555550100

# Supabase shared storage (leave unset -> Vercel Blob if configured, else JSON file at .data/)
# project URL or copied Data API URL ending in /rest/v1 both work
SUPABASE_URL=
# server-only secret key; legacy SUPABASE_SERVICE_ROLE_KEY also works
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=arp_documents
SUPABASE_FURNITURE_BUCKET=furniture-assets
SUPABASE_FURNITURE_ASSETS_TABLE=arp_furniture_assets

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# tried in order when the main model is busy (503), out of quota (429; the free tier allows 20 requests/day per model) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Backboard memory
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Photon iMessage
SPECTRUM_PROJECT_ID=
# server-only Spectrum project secret; alias for PHOTON_API_KEY
SPECTRUM_PROJECT_SECRET=
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
PHOTON_BASE_URL=https://spectrum.photon.codes
# our iMessage line id/handle
PHOTON_FROM=

# Guarded test checkout configuration is below; no live payments or escrow.

# Web app (Vite) — prefixed so they reach the browser
VITE_API_URL=http://localhost:8000

# Expo — LAN IP of this Mac for the dev server URLs
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173

# Housing comparisons (sample rooms explicitly select demo; real mode never falls back)
HOUSING_DATA_MODE=demo
# server-only; whole-apartment listing candidates
RENTCAST_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth: public project key only in Vite/Expo. Never copy a secret/service key here.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# private bucket, migration 002
EVIDENCE_BUCKET=housing-evidence

# TEST ONLY. Apply migrations/001_payment_ledger.sql before enabling stripe_test.
# demo | stripe_test; live is rejected
PAYMENTS_MODE=demo
# server-only PostgreSQL DSN; use SSL for hosted DBs
PAYMENTS_DATABASE_URL=
# sk_test_ only
STRIPE_SECRET_KEY=
# connected acct_ test landlord; scripts/seed_stripe_test.py
STRIPE_CONNECTED_ACCOUNT=
# whsec_ for CONNECT account events (not just platform events)
STRIPE_WEBHOOK_SECRET=
# Optional, disposable database for integration tests; never use a production database:
ARP_TEST_DATABASE_URL=
