{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomplanner.dev/schemas/room.schema.json",
  "title": "Room",
  "type": "object",
  "required": [
    "id",
    "name",
    "skeleton",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "userId": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "skeleton": {
      "$ref": "skeleton.schema.json"
    },
    "source": {
      "type": "string",
      "enum": [
        "scan",
        "manual",
        "sample"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "spaceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "bedroom | study | living | workout | creative | shared (multi-select)"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "furnitureIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "custom": {
            "type": "boolean"
          },
          "zone": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "w": {
                "type": "number"
              },
              "d": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "detectedObjects": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "RoomPlan-detected furniture kept aside when the room was created clean (seed:false)"
    }
  }
}
