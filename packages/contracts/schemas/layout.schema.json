{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomplanner.dev/schemas/layout.schema.json",
  "title": "Layout",
  "type": "object",
  "required": ["id", "roomId", "name", "isCurrent", "items", "zones"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "roomId": {"type": "string"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "kind": {"type": "string", "enum": ["base", "current", "variant"], "description": "base is read-only; one base and one current per room; isCurrent mirrors kind == current"},
    "isCurrent": {"type": "boolean"},
    "version": {"type": "integer", "minimum": 1, "description": "optimistic concurrency: PUT with a stale version is a 409"},
    "promotedFromName": {"type": "string"},
    "parentLayoutId": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "furnitureId", "x", "z", "rotation", "locked"], "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "description": "instance id, unique within the layout"},
          "furnitureId": {"type": "string"},
          "x": {"type": "number"}, "z": {"type": "number"},
          "rotation": {"type": "number", "enum": [0, 90, 180, 270]},
          "locked": {"type": "boolean"},
          "color": {"type": ["string", "null"]}
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object", "required": ["label", "x", "z", "w", "d"], "additionalProperties": true,
        "properties": {"label": {"type": "string"}, "x": {"type": "number"}, "z": {"type": "number"}, "w": {"type": "number"}, "d": {"type": "number"}, "type": {"type": "string", "enum": ["clear", "keep_clear"]}}
      }
    },
    "metrics": {
      "type": ["object", "null"],
      "properties": {
        "openFloor": {"type": "number"}, "conflicts": {"type": "integer"},
        "walkability": {"type": "string", "enum": ["Good", "Tight", "Blocked"]},
        "reachableStorage": {"type": "number"},
        "openFloorPct": {"type": "number"}, "warnings": {"type": "array", "items": {"type": "string"}},
        "largestFreeRect": {"type": "object", "properties": {"x": {"type": "number"}, "z": {"type": "number"}, "w": {"type": "number"}, "d": {"type": "number"}, "areaM2": {"type": "number"}, "fits": {"type": "string"}}}
      }
    },
    "createdBy": {"type": "string", "enum": ["user", "agent", "system"]},
    "requestText": {"type": ["string", "null"]},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"}
  }
}
