{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomplanner.dev/schemas/plan.schema.json",
  "title": "AgentPlan",
  "description": "Gemini structured output. Zone-level only: the model never emits coordinates.",
  "type": "object",
  "required": ["intent", "reply"],
  "additionalProperties": false,
  "properties": {
    "intent": {"type": "string", "enum": ["fit_item", "make_space", "keep_clear", "compare", "redesign", "answer", "rent_check", "payment_check", "housing_quality", "clarify"]},
    "variantName": {"type": "string"},
    "theme": {"type": "string", "description": "redesign only: the new design in a few words ('cozy japandi study'); the server furnishes it from the catalog"},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type"], "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "enum": ["lock", "adjacent", "keep_clear", "clear_zone"]},
          "item": {"type": "string", "description": "furniture id, instance id or plain-language item name"},
          "feature": {"type": "string", "enum": ["window", "door", "outlet", "wall"]},
          "w_m": {"type": "number"}, "d_m": {"type": "number"},
          "label": {"type": "string"},
          "optional": {"type": "boolean"}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type", "item"], "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "enum": ["add", "move", "remove", "rotate"]},
          "item": {"type": "string"},
          "zone": {"type": "string", "description": "e.g. 'window wall, beside window', 'east wall, centered', 'near outlet', 'opposite the door', 'corner'"},
          "rotation": {"type": "number"}
        }
      }
    },
    "roomSummary": {"type": "string", "description": "the designer's one-sentence say-back of the room (interior-designer skill, step 1)"},
    "options": {
      "type": "array", "maxItems": 3,
      "description": "1-3 genuinely different arrangements, favorite first; the top-level variantName/actions/constraints repeat the favorite",
      "items": {
        "type": "object", "required": ["variantName", "actions"], "additionalProperties": false,
        "properties": {
          "variantName": {"type": "string"},
          "actions": {"$ref": "#/properties/actions"},
          "constraints": {"$ref": "#/properties/constraints"},
          "explanation": {"type": "string"},
          "tradeoff": {"type": "string"}
        }
      }
    },
    "recommended": {"type": "string", "description": "variantName of the favorite option"},
    "reply": {"type": "string"},
    "clarifyingQuestion": {"type": "string"},
    "preferencesLearned": {"type": "array", "items": {"type": "string"}}
  }
}
